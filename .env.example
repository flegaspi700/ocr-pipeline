# Copy this file to .env and fill in real values. .env is git-ignored;
# this file is committed so everyone can see which variables are needed.
# Never put real secrets in this file. See docs/14-security.md -> Secrets.

# Baidu OCR backend (src/ocr_pipeline/backend.py)
BAIDU_OCR_API_KEY=replace-with-your-key
BAIDU_OCR_API_URL=replace-with-the-endpoint-url
